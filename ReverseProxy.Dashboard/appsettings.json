{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "control-plane-api": {
        "ClusterId": "control-plane",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "control-plane-health": {
        "ClusterId": "control-plane",
        "Match": {
          "Path": "/health/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "control-plane": {
        "Destinations": {
          "api": {
            "Address": "http://reverseproxy-webapi:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
