{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Redis": {
    "ChannelName": "reverseproxy:config:published",
    "SubscriptionRetryDelay": "00:00:05",
    "ReconciliationInterval": "00:00:30"
  },
  "Outbox": {
    "BatchSize": 32,
    "PollInterval": "00:00:01",
    "FailureDelay": "00:00:05"
  },
  "Operations": {
    "BatchSize": 32,
    "PollInterval": "00:00:05"
  },
  "AllowedHosts": "localhost;reverseproxy-webapi"
}
